GEMINI_API_KEY=your_key_here
# Per-model free-tier caps (quotas are separate per model id)
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
GEMINI_RPM=15
GEMINI_RPD=500
# Skip Playwright for these host suffixes after httpx fails (Indeed captcha hell).
# Empty = try browser everywhere. Default if unset: indeed.com
# BROWSER_SKIP_HOSTS=indeed.com

